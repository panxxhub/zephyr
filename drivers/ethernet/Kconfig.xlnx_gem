menuconfig ETH_XLNX_GEM
	bool "Xilinx GEM Ethernet driver"
	default y
	depends on DT_HAS_XLNX_GEM_ENABLED
	depends on !QEMU_TARGET || (QEMU_TARGET && NET_QEMU_ETHERNET)
	select NOCACHE_MEMORY if ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	select CACHE_MANAGEMENT if DCACHE
	select NET_CHECKSUM_OFFLOAD_SUPPORTED if NET_L2_ETHERNET
	select MDIO if DT_HAS_XLNX_GEM_MDIO_ENABLED
	help
	  Enable Xilinx GEM Ethernet driver.

config ETH_NIC_MODEL
	string
	default "cadence_gem"
	depends on ETH_XLNX_GEM
	help
	  Value of the -nic parameter to be used when starting QEMU.
	  This parameter specifies which type of Ethernet controller
	  shall be simulated by QEMU.

if ETH_XLNX_GEM

config ETH_XLNX_GEM_RX_THREAD
	bool "Deferred GEM work on a driver-owned thread"
	help
	  Run the deferred receive handling of every GEM instance, and the
	  transmit completion handling of those instances which defer it, on a
	  work queue owned by this driver instead of the system work queue.

	  The system work queue is shared with every other subsystem, so GEM
	  receive processing both waits behind unrelated work items and delays
	  them in turn. A driver-owned queue makes the receive cost of this
	  driver schedulable and attributable on its own thread, named "gem_rx".

	  All GEM instances share the one queue, so the order in which a single
	  instance's work items run is unchanged.

config ETH_XLNX_GEM_RX_THREAD_PRIORITY
	int "Priority of the GEM work queue thread"
	default SYSTEM_WORKQUEUE_PRIORITY
	depends on ETH_XLNX_GEM_RX_THREAD
	help
	  Thread priority of the driver-owned GEM work queue. The default
	  matches the system work queue, so enabling the thread on its own
	  changes which thread runs the work, not at which priority.

config ETH_XLNX_GEM_RX_THREAD_STACK_SIZE
	int "Stack size of the GEM work queue thread"
	default 2048
	depends on ETH_XLNX_GEM_RX_THREAD
	help
	  Stack size of the driver-owned GEM work queue thread, in bytes.

config ETH_XLNX_GEM_FRAME_SIZED_CACHE_OPS
	bool "Size GEM cache maintenance to the frame length"
	depends on DCACHE
	help
	  Invalidate and clean only the cache lines a frame actually occupies
	  instead of the whole DMA buffer holding it.

	  The driver reserves a buffer per descriptor, typically 1536 or 2048
	  bytes, but most frames are far shorter, and on a Cortex-A9 with an
	  outer L2 cache every maintenance operation is charged to the one
	  global cache lock the other core shares. Sizing the operation to the
	  frame cuts the work and the lock hold to what the transfer needs.

	  A length is rounded up to the next cache line, so the operation still
	  covers every byte the frame touches. Buffers start on a cache line
	  boundary and their size is a multiple of the line size, which the
	  driver asserts at build time, so the rounded-up span stays inside the
	  buffer it belongs to.

	  When this option is disabled, whole buffers are maintained, which is
	  the historical behaviour.

config ETH_XLNX_GEM_TX_DONE_WORKQ
	bool "Reclaim GEM transmit descriptors outside the interrupt"
	help
	  Handle transmit completion on a work queue for every GEM instance,
	  as if each of them had the handle-tx-in-workq device tree property
	  set.

	  Unless an instance defers it, the driver walks the buffer
	  descriptors of a completed frame inside the interrupt service
	  routine, which makes the cost of the interrupt proportional to the
	  number of descriptors that frame occupies - up to the whole transmit
	  ring. Deferring the walk leaves the service routine with a fixed
	  number of register accesses and one work item submission.

	  The reclamation then runs under the transmit ring semaphore, the
	  protection the driver already uses for this path, rather than under
	  the interrupt masking used when reclaiming inside the service
	  routine. Enable CONFIG_ETH_XLNX_GEM_RX_THREAD as well to keep that
	  work off the system work queue.

	  When this option is disabled, only instances whose device tree asks
	  for it defer transmit completion, which is the historical behaviour.

endif # ETH_XLNX_GEM
